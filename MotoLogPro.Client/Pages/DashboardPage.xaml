<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MotoLogPro.Client.ViewModels"
             xmlns:models="clr-namespace:MotoLogPro.Shared.DTOs;assembly=MotoLogPro.Shared"
             x:Class="MotoLogPro.Client.Pages.DashboardPage"
             Title="Garage Officina"
             BackgroundColor="#F5F5F5">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Esci"       Command="{Binding LogoutCommand}"   Order="Primary" Priority="1" />
        <ToolbarItem Text="Nuova Moto" Command="{Binding AddNewVehicleCommand}" Order="Primary" Priority="0" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" BackgroundColor="#2196F3" Padding="20">
            <Label Text="Benvenuto in MotoLogPro" TextColor="White"  FontSize="18" FontAttributes="Bold"/>
            <Label Text="Seleziona un veicolo per iniziare" TextColor="#E3F2FD" FontSize="14"/>
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="#2196F3"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding HasError}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12"
                             Padding="30">
            <Label Text="⚠️" FontSize="48" HorizontalOptions="Center"/>
            <Label Text="{Binding ErrorMessage}"
                   TextColor="#B71C1C"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontSize="14"/>
            <Button Text="Riprova"
                    Command="{Binding LoadDataCommand}"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    CornerRadius="8"
                    HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Vehicles}"
                        Margin="10"
                        IsVisible="{Binding IsNotBusy}">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="{OnIdiom Phone=1, Tablet=2, Desktop=3}"
                                 VerticalItemSpacing="10"
                                 HorizontalItemSpacing="10"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:VehicleDto">

                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Modifica" 
                                           BackgroundColor="#FFB300"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=EditMotorcycleCommand}"
                                           CommandParameter="{Binding .}" />
                                <SwipeItem Text="Elimina" 
                                           BackgroundColor="#D32F2F"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=DeleteMotorcycleCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="0"
                                BackgroundColor="White"
                                Padding="0"
                                HeightRequest="160">

                            <FlyoutBase.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Modifica" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=EditMotorcycleCommand}"
                                                    CommandParameter="{Binding .}" />
                                    <MenuFlyoutItem Text="Elimina" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=DeleteMotorcycleCommand}"
                                                    CommandParameter="{Binding .}" />
                                </MenuFlyout>
                            </FlyoutBase.ContextFlyout>

                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.1"/>
                            </Border.Shadow>

                            <Grid RowDefinitions="*, Auto" ColumnDefinitions="Auto, *">
                                <BoxView Grid.RowSpan="2" Grid.Column="0" WidthRequest="10" Color="#2196F3"/>
                                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Padding="15,15,15,5" Spacing="2">
                                    <Label Text="{Binding Brand}"        TextColor="#757575" FontSize="12" TextTransform="Uppercase"/>
                                    <Label Text="{Binding Model}"        TextColor="#212121" FontSize="20" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Vin}"          TextColor="#9E9E9E" FontSize="12" FontFamily="Consolas" Margin="0,5,0,0"/>
                                </VerticalStackLayout>
                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, Auto" Padding="15,0,15,15">
                                    <Label Grid.Column="0" Text="{Binding LicensePlate}" TextColor="#424242" FontSize="14" FontAttributes="Bold" VerticalOptions="End"/>
                                    <Label Grid.Column="1" Text="{Binding Year}"         TextColor="#2196F3" FontAttributes="Bold" FontSize="18" VerticalOptions="End"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout IsVisible="{Binding ShowEmptyState}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="10">
                    <Label Text="🏍️" FontSize="60" HorizontalOptions="Center"/>
                    <Label Text="Nessuna moto registrata" TextColor="Gray"
                           FontSize="16" HorizontalOptions="Center"/>
                    <Label Text="Tocca «Nuova Moto» per aggiungerne una"
                           TextColor="#BDBDBD" FontSize="13"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>
</ContentPage>